setwd("~/"D:\\1st Semester\\BMS309\\Practical_machine _learning"")
setwd("~/"D:\\1st Semester\\BMS309\\Practical_machine _learning"")
# Install packages if they are not already installed
install.packages("caret")
install.packages("randomForest")
install.packages("rmarkdown")
# Load libraries
library(caret)
library(randomForest)
library(rmarkdown)
# Download training dataset
download.file(
"https://d396qusza40orc.cloudfront.net/predmachlearn/pml-training.csv",
destfile = "pml-training.csv",
mode = "wb"
)
# Download testing dataset
download.file(
"https://d396qusza40orc.cloudfront.net/predmachlearn/pml-testing.csv",
destfile = "pml-testing.csv",
mode = "wb"
)
# Load training dataset
training <- read.csv("pml-training.csv")
# Load testing dataset
testing <- read.csv("pml-testing.csv")
# Check dataset dimensions
dim(training)
dim(testing)
# View first few rows
head(training)
# Check column names
names(training)
# Check data structure
str(training)
# Check target variable distribution
table(training$classe)
# Check missing values
missing_values <- colSums(is.na(training))
# Display columns with missing values
missing_values[missing_values > 0]
# Remove columns containing mostly missing values
training_clean <- training[
, colSums(is.na(training)) == 0
]
# Remove identification and metadata columns
training_clean <- training_clean[
, -(1:7)
]
# Apply the same cleaning to testing data
testing_clean <- testing[
, names(training_clean)[names(training_clean) != "classe"]
]
# Check dimensions
dim(training_clean)
dim(testing_clean)
set.seed(123)
train_index <- createDataPartition(
training_clean$classe,
p = 0.75,
list = FALSE
)
train_data <- training_clean[train_index, ]
validation_data <- training_clean[-train_index, ]
# Set cross-validation method
control <- trainControl(
method = "cv",
number = 5
)
# Train Random Forest
set.seed(123)
model <- train(
classe ~ .,
data = train_data,
method = "rf",
trControl = control,
ntree = 100
)
